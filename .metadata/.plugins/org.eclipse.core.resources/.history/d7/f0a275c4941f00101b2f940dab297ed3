package TP3.EJ2;

import java.util.*;
import Practica1.ej8.*;
import Practica1.ej8.Queue;
import TP2.EJ1.BinaryTree;
import TP3.EJ1.*;

public class RecorridosAG {
	
	
//	Método que retorna una lista con los elementos impares del árbol “a” que sean mayores al valor “n”
//	pasados como parámetros, recorrido en preorden.
	
	public List<Integer> numerosImparesMayoresQuePreOrden (GeneralTree <Integer> a, Integer n){
		LinkedList<Integer> lista = new LinkedList<Integer>();
		if (! a.isEmpty()) {
			imparesPreOrden (a,n,lista);
		}
		return lista;
	}
	private boolean esImpar (int num) {
		return (num % 2) != 0;
	}
	private void imparesPreOrden (GeneralTree <Integer> a, Integer n, LinkedList<Integer> l) {
		int valor = a.getData();
		if (esImpar(valor) && valor > n) l.add(valor);
		if (a.hasChildren()) {
			List<GeneralTree<Integer>> children = a.getChildren();
			for (GeneralTree<Integer> child : children) {
				imparesPreOrden(child, n, l);
			}
		}
	}
	
	public List<Integer> numerosImparesMayoresQueInOrden (GeneralTree <Integer> a, Integer n){
		LinkedList<Integer> lista = new LinkedList<Integer>();
		if (! a.isEmpty()) {
			imparesInOrden (a,n,lista);
		}
		return lista;
	}
	
	private void imparesInOrden (GeneralTree <Integer> a, Integer n, LinkedList<Integer> l) {
		List<GeneralTree<Integer>> children = a.getChildren();
		if (a.hasChildren()) {
			imparesInOrden(children.get(0), n,l);
		}
		int valor = a.getData();
		if (esImpar(valor) && valor > n) l.add(valor);
		for (int i = 1; i<children.size();i++) {
			imparesInOrden(children.get(i), n,l);
		}
	}
	
	public List<Integer> numerosImparesMayoresQuePostOrden (GeneralTree <Integer> a, Integer n){
		LinkedList<Integer> lista = new LinkedList<Integer>();
		if (! a.isEmpty()) {
			imparesPostOrden (a,n,lista);
		}
		return lista;
	}
	
	private void imparesPostOrden (GeneralTree <Integer> a, Integer n, LinkedList<Integer> l) {
		if (a.hasChildren()) {
			List<GeneralTree<Integer>> children = a.getChildren();
			for (GeneralTree<Integer> child : children) {
				imparesPreOrden(child, n, l);
			}
		}
		int valor = a.getData();
		if (esImpar(valor) && valor > n) l.add(valor);
	}
	
	public List<Integer> numerosImparesMayoresQuePorNiveles(GeneralTree <Integer> a,Integer n){
		LinkedList<Integer> lista = new LinkedList<Integer>();
		GeneralTree<Integer> aux;
		Queue <BinaryTree<Integer>> cola = new Queue<>();
		cola.enqueue(a);
		while (!cola.isEmpty()) {
			aux = cola.dequeue();
			if (!aux.isEmpty()) {
				int valor = aux.getData();
				if (esImpar(valor) && valor > n) lista.add(valor);
			}
			List<GeneralTree<Integer>> children = a.getChildren();
			for (GeneralTree<Integer> child : children) {
				cola.enqueue(child);
			}
		}
		return lista;
	}
	
}
